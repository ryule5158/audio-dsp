# STM32CubeH7's generated sources retain vendor alignment spaces and terminal
# blank lines. CubeMX restores them on every regeneration, so keep the vendor
# bytes intact and apply whitespace checks to the hand-written App/scripts.
mcu/project/STM32H743_Audio/.mxproject -whitespace
mcu/project/STM32H743_Audio/Core/** -whitespace
mcu/project/STM32H743_Audio/Drivers/** -whitespace
mcu/project/STM32H743_Audio/MDK-ARM/startup_stm32h743xx.s -whitespace
