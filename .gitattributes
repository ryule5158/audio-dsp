# STM32CubeH7's generated sources retain vendor alignment spaces and terminal
# blank lines. CubeMX restores them on every regeneration, so keep the vendor
# bytes intact and apply whitespace checks to the hand-written App/scripts.
mcu/project/STM32H743_Audio/.mxproject -whitespace
mcu/project/STM32H743_Audio/Core/** -whitespace
mcu/project/STM32H743_Audio/Drivers/** -whitespace
mcu/project/STM32H743_Audio/MDK-ARM/startup_stm32h743xx.s -whitespace
*.ld text eol=lf
*.tcl text eol=lf
*.v text eol=lf
*.sv text eol=lf
*.vh text eol=lf
*.xdc text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.init text eol=lf
*.env text eol=lf
*.patch text eol=lf
*.sct text eol=lf
*.txt text eol=lf
*.dbgconf text eol=lf
*.pdf binary
*.bin binary
*.raw binary
# Fixed upstream byte provenance must survive git add/checkout on Windows.
mcu/project/STM32H743_Audio/App/LVGL/src/** -text -whitespace
mcu/project/STM32H743_Audio/App/LVGL/lvgl.h -text
mcu/project/STM32H743_Audio/App/LVGL/lvgl_private.h -text
mcu/project/STM32H743_Audio/App/LVGL/lv_version.h -text
mcu/project/STM32H743_Audio/App/LVGL/lv_conf_template.h -text -whitespace
mcu/project/STM32H743_Audio/App/LVGL/LICENCE.txt -text
mcu/project/STM32H743_Audio/App/LVGL/COPYRIGHTS.md -text
mcu/project/STM32H743_Audio/App/Generic_DSP/*.c -text -whitespace
mcu/project/STM32H743_Audio/App/Generic_DSP/*.h -text -whitespace
mcu/project/STM32H743_Audio/Drivers/STM32H7xx_HAL_Driver/Inc/stm32h7xx_hal_spi.h -text
mcu/project/STM32H743_Audio/Drivers/STM32H7xx_HAL_Driver/Inc/stm32h7xx_hal_spi_ex.h -text
